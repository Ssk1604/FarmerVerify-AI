# FarmerVerify AI — Environment Configuration
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control.
# All values below are placeholders only.
# ─────────────────────────────────────────────

# ── LLM / OCR API ──
# Any OpenAI-compatible API endpoint works here
# e.g. OpenAI, Azure OpenAI, Ollama, Groq etc.
OCR_API_KEY=your_llm_api_key_here
OCR_API_URL=https://api.openai.com/v1/chat/completions
OCR_MODEL=gpt-4-vision-preview

# ── Google Cloud (Speech-to-Text / Text-to-Speech) ──
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account.json
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-south1

# ── WhatsApp Business API (via Twilio) ──
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+1XXXXXXXXXX

# ── Database ──
DATABASE_URL=postgresql://user:password@localhost:5432/farmerverify
DATABASE_NAME=farmerverify
DATABASE_USER=your_db_user
DATABASE_PASSWORD=your_db_password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# ── Application ──
SECRET_KEY=generate_a_long_random_string_here
DEBUG=False
ENVIRONMENT=development
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Storage ──
STORAGE_BUCKET=your-storage-bucket-name
STORAGE_REGION=ap-south-1

# ── Optional: Fraud Detection ──
ELA_THRESHOLD=0.3
HASH_SIMILARITY_THRESHOLD=0.95
